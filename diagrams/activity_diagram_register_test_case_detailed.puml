
@startuml activity diagram
title Aktivitetsdiagram - Registrera testfall - Detaljerad version

start

partition "TestCaseDialog" {
    :Visa huvudmenyn;
    :Användaren väljer alternativ 1;
    :Anropa create_test_case_menu();
    :Skapa CreateTestCaseDto;
}

partition "ConsoleHelper / TestCaseDialog" {

    repeat
        :Begär testfalls-ID (tc_id);
        :Anropa required_input();
        :Läs in och normalisera med strip();
    repeat while (Är värdet tomt?) is (Ja)
    -> Nej;
    :Tilldela dto.tc_id;

    repeat
        :Begär titel (title);
        :Anropa required_input();
        :Läs in och normalisera med strip();
    repeat while (Är värdet tomt?) is (Ja)
    -> Nej;
    :Tilldela dto.title;

    repeat
        :Begär syfte (purpose);
        :Anropa required_input();
        :Läs in och normalisera med strip();
    repeat while (Är värdet tomt?) is (Ja)
    -> Nej;
    :Tilldela dto.purpose;

    repeat
        :Begär acceptanskriterier;
        :Anropa required_input();
        :Läs in och normalisera med strip();
    repeat while (Är värdet tomt?) is (Ja)
    -> Nej;
    :Tilldela dto.acceptance_criteria;

    repeat
        :Begär förutsättningar (preconditions);
        :Anropa required_input();
        :Läs in och normalisera med strip();
    repeat while (Är värdet tomt?) is (Ja)
    -> Nej;
    :Tilldela dto.preconditions;

    repeat
        :Begär testdata (test_data);
        :Anropa required_input();
        :Läs in och normalisera med strip();
    repeat while (Är värdet tomt?) is (Ja)
    -> Nej;
    :Tilldela dto.test_data;

    repeat
        :Begär teststeg (steps);
        :Anropa required_input();
        :Läs in och normalisera med strip();
    repeat while (Är värdet tomt?) is (Ja)
    -> Nej;
    :Tilldela dto.steps;

    repeat
        :Begär förväntat resultat (expected_result);
        :Anropa required_input();
        :Läs in och normalisera med strip();
    repeat while (Är värdet tomt?) is (Ja)
    -> Nej;
    :Tilldela dto.expected_result;

    :Samtliga fält har samlats in;
    :Skicka DTO till TestCaseService;
}

partition "TestCaseService" {
    :Ta emot CreateTestCaseDto;
    :Normalisera inmatade strängar med strip();

    if (Är tc_id ifyllt?) then (Ja)
    else (Nej)
        :Skapa CreateTestCaseResult;
        :succeeded = False;
        :message = Felmeddelande;
        :test_case = None;
        :Returnera resultatet till TestCaseDialog;
        :Visa felmeddelande;
        :Användaren återgår till huvudmenyn;
        end
    endif

    if (Är title ifyllt?) then (Ja)
    else (Nej)
        :Skapa CreateTestCaseResult;
        :succeeded = False;
        :message = Felmeddelande;
        :test_case = None;
        :Returnera resultatet till TestCaseDialog;
        :Visa felmeddelande;
        :Användaren återgår till huvudmenyn;
        end
    endif

    if (Är purpose ifyllt?) then (Ja)
    else (Nej)
        :Skapa CreateTestCaseResult;
        :succeeded = False;
        :message = Felmeddelande;
        :test_case = None;
        :Returnera resultatet till TestCaseDialog;
        :Visa felmeddelande;
        :Användaren återgår till huvudmenyn;
        end
    endif

    if (Är acceptance_criteria ifyllt?) then (Ja)
    else (Nej)
        :Skapa CreateTestCaseResult;
        :succeeded = False;
        :message = Felmeddelande;
        :test_case = None;
        :Returnera resultatet till TestCaseDialog;
        :Visa felmeddelande;
        :Användaren återgår till huvudmenyn;
        end
    endif

    if (Är preconditions ifyllt?) then (Ja)
    else (Nej)
        :Skapa CreateTestCaseResult;
        :succeeded = False;
        :message = Felmeddelande;
        :test_case = None;
        :Returnera resultatet till TestCaseDialog;
        :Visa felmeddelande;
        :Användaren återgår till huvudmenyn;
        end
    endif

    if (Är test_data ifyllt?) then (Ja)
    else (Nej)
        :Skapa CreateTestCaseResult;
        :succeeded = False;
        :message = Felmeddelande;
        :test_case = None;
        :Returnera resultatet till TestCaseDialog;
        :Visa felmeddelande;
        :Användaren återgår till huvudmenyn;
        end
    endif

    if (Är steps ifyllt?) then (Ja)
    else (Nej)
        :Skapa CreateTestCaseResult;
        :succeeded = False;
        :message = Felmeddelande;
        :test_case = None;
        :Returnera resultatet till TestCaseDialog;
        :Visa felmeddelande;
        :Användaren återgår till huvudmenyn;
        end
    endif

    if (Är expected_result ifyllt?) then (Ja)
    else (Nej)
        :Skapa CreateTestCaseResult;
        :succeeded = False;
        :message = Felmeddelande;
        :test_case = None;
        :Returnera resultatet till TestCaseDialog;
        :Visa felmeddelande;
        :Användaren återgår till huvudmenyn;
        end
    endif

    :Skapa TestCase-objekt
    med TestCase().create(dto);

    :Skicka TestCase-objekt till repository;
}

partition "TestCaseRepository" {
    :Anropa try_create_test_case();
    :Lägg till TestCase-objektet
    i den interna listan;
}

partition "TestCaseService" {
    :Skapa CreateTestCaseResult;
    :succeeded = True;
    :message = Framgångsmeddelande;
    :test_case = TestCase-objekt;
    :Returnera resultatet till TestCaseDialog;
}

partition "TestCaseDialog" {
    :Ta emot CreateTestCaseResult;

    if (result.succeeded?) then (True)
        :Visa framgångsmeddelande;
    else (False)
        :Visa felmeddelande;
    endif

    :Anropa pause();
    :Återgå till huvudmenyn;
}

stop

@enduml