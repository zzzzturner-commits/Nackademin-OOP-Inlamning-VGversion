@startuml activity diagram
title Aktivitetsdiagram - Registrera testfall - Förenklad version

start

partition "TestCaseDialog" {
    :Användaren väljer Registrera testfall;
    :Anropa create_test_case_menu();
    :Skapa CreateTestCaseDto;
}

partition "ConsoleHelper" {
    :Samla in samtliga åtta obligatoriska fält;
    :Anropa required_input() för varje fält;
    :Normalisera inmatning med strip();

    while (Är aktuellt inmatningsfält tomt?) is (Ja)
        :Visa felmeddelande;
        :Begär ny inmatning;
        :Normalisera värdet med strip();
    endwhile (Nej)
}

partition "TestCaseDialog" {
    :Tilldela värden till DTO;
    :Skicka DTO till TestCaseService;
}

partition "TestCaseService" {
    :Ta emot CreateTestCaseDto;
    :Normalisera inmatade strängar strip();
    :Validera varje obligatoriskt fält separat;

    if (Är samtliga fält godkända?) then (Ja)
        :Skapa TestCase-objekt;
        :Skicka objektet till repository;

        partition "TestCaseRepository" {
            :Lägg till TestCase-objektet
            i den interna listan;
        }

        partition "TestCaseService" {
            :Skapa CreateTestCaseResult;
            :succeeded = True;
            :message = Framgångsmeddelande;
            :test_case = TestCase-objekt;
        }

    else (Nej)
        :Skapa CreateTestCaseResult;
        :succeeded = False;
        :message = Felmeddelande;
        :test_case = None;
    endif

    :Returnera CreateTestCaseResult;
}

partition "TestCaseDialog" {
    :Ta emot CreateTestCaseResult;

    if (result.succeeded?) then (True)
        :Visa framgångsmeddelande;
    else (False)
        :Visa felmeddelande;
    endif

    :Anropa pause();
    :Återgå till huvudmenyn;
}

stop

@enduml